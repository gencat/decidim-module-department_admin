<% add_decidim_page_title(t("areas", scope: "decidim.admin.titles")) %>
<div class="card" id="departments">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t "decidim.admin.titles.departments" %>
      <% if allowed_to? :create, :department %>
        <%= link_to t("actions.add", scope: "decidim.admin"), decidim_admin_department_admin.new_department_path, class: "button button__sm button__secondary new" %>
      <% end %>
    </h1>
  </div>

  <% if @departments.any? %>
    <div class="table-scroll">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t("models.department.fields.name", scope: "decidim.department_admin.admin") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @departments.each do |dept| %>
            <tr>
              <td>
                <% if allowed_to? :update, :department, department: dept %>
                  <%= link_to translated_attribute(dept.name), decidim_admin_department_admin.edit_department_path(dept) %>
                <% else %>
                  <%= translated_attribute(dept.name) %>
                <% end %>
              </td>
              <td class="table-list__actions">
              <% if allowed_to? :update, :department, department: dept %>
                <%= icon_link_to "pencil-line", decidim_admin_department_admin.edit_department_path(dept), t("actions.edit", scope: "decidim.admin"), class: "action-icon--edit", method: :get, data: {} %>
              <% end %>

              <% if allowed_to? :destroy, :department, department: dept %>
                <%= icon_link_to "delete-bin-line", decidim_admin_department_admin.department_path(dept), t("actions.destroy", scope: "decidim.admin"), class: "action-icon--remove", method: :delete, data: { confirm: t("actions.confirm_destroy", scope: "decidim.admin") } %>
              <% end %>
            </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t(".no_departments") %></p>
  <% end %>
</div>
