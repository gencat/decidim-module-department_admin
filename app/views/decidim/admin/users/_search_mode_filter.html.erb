<% if controller_name == "users" %>
  <div class="flex items-center gap-3 mt-2 text-sm">
    <span class="font-medium"><%= t("models.user.fields.search_question", scope: "decidim.admin") %></span>
    <label class="flex items-center gap-1 cursor-pointer">
      <input type="radio" name="filter_search" value="by_process_name" <%= @by_process_name ? "checked" : "" %>>
      <%= t("models.user.fields.search_field_processes", scope: "decidim.admin") %>
    </label>
    <label class="flex items-center gap-1 cursor-pointer">
      <input type="radio" name="filter_search" value="query" <%= params[:filter_search].blank? || params[:filter_search] == "query" ? "checked" : "" %>>
      <%= t("models.user.fields.search_field_admins", scope: "decidim.admin") %>
    </label>
  </div>
<% end %>
