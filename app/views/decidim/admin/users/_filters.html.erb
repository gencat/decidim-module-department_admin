<% if controller_name == "users" %>
  <div class="flex flex-wrap items-center gap-4 mt-2 px-2 py-2 border-t border-gray-200">
    <div class="flex items-center gap-2">
      <label class="text-sm font-medium"><%= t(".filter_by") %>:</label>
      <select class="input input__sm" onchange="window.location.href = this.value">
        <option value="<%= url_for(q: ransack_params) %>" <%= @role.blank? ? "selected" : "" %>><%= t(".filter.all") %></option>
        <% Decidim::User::Roles.all.map do |role| %>
          <option value="<%= url_for(role: role, q: ransack_params) %>" <%= @role == role ? "selected" : "" %>><%= t("models.user.fields.roles.#{role}", scope: "decidim.admin") %></option>
        <% end %>
        <option value="<%= url_for(role: "space_admin", q: ransack_params) %>" <%= @role == "space_admin" ? "selected" : "" %>><%= t("models.user.fields.roles.space_admin", scope: "decidim.admin") %></option>
      </select>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-sm font-medium"><%= t("models.user.fields.search_question", scope: "decidim.admin") %></span>
      <label class="flex items-center gap-1 text-sm">
        <input type="radio" name="filter_search" value="by_process_name" <%= @by_process_name ? "checked" : "" %>>
        <%= t("models.user.fields.search_field_processes", scope: "decidim.admin") %>
      </label>
      <label class="flex items-center gap-1 text-sm">
        <input type="radio" name="filter_search" value="query" <%= params[:filter_search].blank? || params[:filter_search] == "query" ? "checked" : "" %>>
        <%= t("models.user.fields.search_field_admins", scope: "decidim.admin") %>
      </label>
    </div>
  </div>
<% end %>
